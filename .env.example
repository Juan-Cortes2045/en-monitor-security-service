# Copy this file to .env and replace every CHANGE_ME. It is in .gitignore: never commit it.
#
# Spring reads it in .properties format, so write values without quotes and without $:
# a value containing $ is treated as a placeholder and the application fails to start.

# Database. MySQL runs from the infra repository, which creates the energy_app user with
# MYSQL_PASSWORD of infra/.env. Put that same password here: the tests need it, because the
# "test" profile does not load application-local.yaml.
SPRING_DATASOURCE_PASSWORD=

# HTTP port. 8080 stays with energy-monitor-backend when both run on the same machine.
# SERVER_PORT=8082

# Pepper for the recovery code (HMAC). Long and random; generate one with: openssl rand -hex 32
# It must be the value energy-monitor-backend used, or every code already issued stops working.
SECURITY_RESET_PEPPER=CHANGE_ME_long_random_pepper

# Sign in with Google. OAuth client of type "Web application" from Google Cloud Console. Leave
# both empty to disable the Google button (503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend origin the browser may use against the API (the Vite dev server locally).
SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Message broker (RabbitMQ from infra). Account events and mail requests are published there
# through the outbox; without a broker they wait in security_outbox and the health is DOWN.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=energy-monitor
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password
