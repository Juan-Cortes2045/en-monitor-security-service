<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        google_subject is the stable identifier (sub) of the Google account an account was created
        with. NULL for accounts registered with a password: a Google sign-in with the same address
        never takes them over.
    -->
    <changeSet id="security-024-add-user-google-subject" author="JuanCortes2045">
        <comment>user.google_subject: Google account of an account created by signing in with Google.</comment>
        <addColumn tableName="user">
            <column name="google_subject" type="VARCHAR(255)"/>
        </addColumn>
        <addUniqueConstraint tableName="user" columnNames="google_subject"
                             constraintName="uq_user_google_subject"/>

        <rollback>
            <dropUniqueConstraint tableName="user" constraintName="uq_user_google_subject"/>
            <dropColumn tableName="user" columnName="google_subject"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
