<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">    
    
    <!--
        One row per single-use token issued for a password reset request.

        Only the SHA-256 hash of the token is stored. The clear value exists for as long as the
        request that generated it and leaves the server through the delivery channel; a row that
        held it would hand every reader of this table a credential that can be redeemed. The
        lookup on reset is therefore by hash, and the hash is what makes the column unique.

        VARCHAR(64) is the exact width of a lowercase hex SHA-256 digest: 32 bytes rendered as two
        characters each, so the column length is a fact rather than an allowance.
    -->
    <changeSet id="security-004-create-password-reset-token" author="JuanCortes2045">
        <comment>Single-use token issued for a password reset request. Stores only the SHA-256 hash, never the secret.</comment>
        <createTable tableName="password_reset_token">
            <column name="id_reset_token" type="VARCHAR(10)">
                <constraints primaryKey="true" primaryKeyName="pk_password_reset_token" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(10)">
                <constraints nullable="false"
                             foreignKeyName="fk_password_reset_token_user_id"
                             references="user(id_user)"/>
            </column>
            <!-- Lowercase hex SHA-256: 32 bytes rendered as 64 characters. -->
            <column name="reset_token_hash" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uk_password_reset_token_reset_token_hash"/>
            </column>
            <column name="used" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="expiration_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
