<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        The application reads the password policy through PasswordPolicyPersistencePort.activePolicy(),
        which is the first row of findByDeletedAtIsNull(). With no row the lookup is empty and
        RegisterUserService, ResetPasswordService and ChangePasswordService all fail with
        IllegalStateException, so a fresh database could not register a single account.

        The values below are not a security decision of their own: they are the policy the
        application's own use-case fixtures already exercise, so seeding it keeps the running
        behaviour identical to what the test suite verifies. Change them only together with
        UseCaseFixtures.defaultPolicy().

        min_length 8 is also the only value with corroboration outside the tests: the mobile and
        web mockups state "La contrasena debe tener minimo 8 caracteres" and both frontends
        validate min 8.

        Exactly one row is inserted because activePolicy() has no ORDER BY: a second active row
        would make the selected policy non-deterministic. A preCondition keeps this changeset
        idempotent so it never collides with an existing default policy.
    -->
    <changeSet id="security-019-seed-default-password-policy" author="JuanCortes2045">
        <preConditions onFail="MARK_RAN">
            <tableIsEmpty tableName="password_policy"/>
        </preConditions>

        <comment>Seeds the default password policy so registration works on a fresh database.</comment>

        <insert tableName="password_policy">
            <column name="id_password_policy" value="pol0000001"/>
            <column name="min_length" valueNumeric="8"/>
            <column name="max_length" valueNumeric="64"/>
            <column name="require_uppercase" valueBoolean="true"/>
            <column name="require_numbers" valueBoolean="true"/>
            <column name="require_symbols" valueBoolean="true"/>
            <column name="expiration_days" valueNumeric="90"/>
        </insert>

        <rollback>
            <delete tableName="password_policy">
                <where>id_password_policy = 'pol0000001'</where>
            </delete>
        </rollback>
    </changeSet>
</databaseChangeLog>
