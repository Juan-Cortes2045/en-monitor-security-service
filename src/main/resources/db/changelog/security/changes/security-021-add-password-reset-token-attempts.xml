<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Failed attempts at redeeming a recovery code.

        A six-digit code is only defensible because guessing is bounded, and that bound has to be
        stored rather than implied: the alternative is an endpoint that can be asked indefinitely.

        The counter is incremented by a single conditional UPDATE that also acts as the reservation
        of the attempt, which is why it lives in a column at all rather than in memory. Reading
        the count, comparing the code and then writing the count back would leave a window in which
        concurrent requests all read the same value and all pass. See PasswordResetTokenMapper.

        DEFAULT 0 matches every row that exists today: those tokens predate the counter and have
        not been attempted, which is the truth about them.
    -->
    <changeSet id="security-021-add-password-reset-token-attempts" author="JuanCortes2045">
        <comment>Failed redemption attempts per recovery code, reserved atomically before comparison.</comment>
        <addColumn tableName="password_reset_token">
            <column name="attempts" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="password_reset_token" columnName="attempts"/>
        </rollback>
    </changeSet>
</databaseChangeLog>